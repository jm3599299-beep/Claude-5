# --- Públicas (se exponen al navegador; protegidas por RLS) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Secretas (solo servidor / GitHub Actions; NUNCA con prefijo NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=

# Importador de catálogo (CLI / GitHub Actions). Supabase → Settings → Database → Connection string (URI)
DATABASE_URL=
# Revalidación de caché tras importaciones (mínimo 32 caracteres aleatorios: `openssl rand -hex 32`)
REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=

# Tipos de cambio (opcional). Sin clave se usa el acceso abierto de ExchangeRate-API, que exige atribución (se muestra).
# Clave gratuita: https://www.exchangerate-api.com (Free plan) → sin atribución.
EXCHANGERATE_API_KEY=

# Noticias semanales (GitHub Actions). Clave de https://platform.claude.com → API Keys. Secreta.
ANTHROPIC_API_KEY=
# "true" publica el Weekly automáticamente; por defecto queda pendiente de aprobación editorial.
NEWS_AUTO_PUBLISH_WEEKLY=false
